# ── On the server: copy this file to .env and fill it in. Never commit .env. ──

# Where inquiries from the website are delivered.
INQUIRY_TO=

# The mail account that sends them. These are the same names My Expenses uses,
# but the values are this site's own: the host must be the one shown on the
# ZeptoMail Mail Agent's SMTP page. A token only logs in at its own data
# centre (smtp.zeptomail.ca for ours); the wrong one answers 535.
SMTP_HOST=smtp.zeptomail.ca
SMTP_PORT=587
# true for a server that expects TLS from the first byte (usually port 465)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# The address the emails come from. It must be one this mail account may send as.
SMTP_FROM=

# The port the site listens on, on this machine only.
WEB_PORT=8510

# ── For local development only (npm run dev / npm run build) ──
# Where the forms are sent. The Docker build sets this to /api/inquiry by itself.
# Left empty, the forms say they are not switched on.
VITE_INQUIRY_ENDPOINT=
